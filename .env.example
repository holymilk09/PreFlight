# =============================================================================
# SECURITY NOTICE: Generate unique secrets before use!
# Run: openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# Database Credentials (REQUIRED - docker-compose will fail without these)
# -----------------------------------------------------------------------------
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
POSTGRES_DB=controlplane

REDIS_PASSWORD=GENERATE_SECURE_PASSWORD_HERE

# -----------------------------------------------------------------------------
# Connection URLs (update passwords to match above)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# -----------------------------------------------------------------------------
# Authentication (REQUIRED - generate secure values!)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# API key hashing salt - Generate with: openssl rand -hex 32
API_KEY_SALT=GENERATE_WITH_openssl_rand_-hex_32

# Login lockout (per-user brute-force protection)
# Consecutive failed logins before an account is temporarily locked (1 - 100).
LOGIN_MAX_FAILED_ATTEMPTS=5
# Minutes an account stays locked after too many failed logins (1 - 1440).
LOGIN_LOCKOUT_MINUTES=15
# When true, a locked account is told so explicitly (HTTP 429 + Retry-After).
# When false (default), it gets the same generic 401 as a wrong password so the
# lock cannot be used to enumerate which accounts exist. Lockouts are always
# recorded in the audit trail regardless of this setting.
LOGIN_LOCKOUT_REVEAL=false

# Webhook signing-secret encryption key (Fernet). Optional: if unset, a key is
# derived from JWT_SECRET. For independent rotation, generate a dedicated key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WEBHOOK_ENC_KEY=

# -----------------------------------------------------------------------------
# CORS Security (comma-separated list of allowed origins)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_DOCS=true  # Set to false in production

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0  # Use 0.0.0.0 for containers, 127.0.0.1 for local-only
API_PORT=8000

# -----------------------------------------------------------------------------
# Request Limits
# -----------------------------------------------------------------------------
MAX_REQUEST_BODY_SIZE=1048576  # 1MB default, max 10MB

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_UNAUTHENTICATED=10

# -----------------------------------------------------------------------------
# Fail-Closed Security & Webhooks (Phase 1)
# -----------------------------------------------------------------------------
# When true, requests are rejected (503) if Redis (rate-limit / token-revocation
# backend) is unavailable, and tokens that cannot be verified are treated as
# revoked (401). Governance posture; set to false for legacy fail-open behavior.
SECURITY_FAIL_CLOSED=true
# Per-request timeout (seconds) for outbound webhook delivery (0.5 - 30).
WEBHOOK_TIMEOUT_SECONDS=5.0
# Replay window (seconds) advertised for the signed webhook timestamp (30 - 3600).
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# Rolling Baselines
# -----------------------------------------------------------------------------
# EWMA rate for blending healthy MATCH evaluations into template baselines so
# gradual legitimate evolution doesn't become a permanent drift false alarm.
# Only confident (>=0.85), green-drift (<0.15) evaluations update; identity
# fields (tables/pages/columns/header/footer) never blend. 0 disables.
BASELINE_LEARNING_RATE=0.05

# -----------------------------------------------------------------------------
# Reliability Self-Calibration
# -----------------------------------------------------------------------------
# EWMA rate for moving a template's baseline_reliability toward reported
# feedback outcomes (correct=1.0 / corrected=0.5 / rejected=0.0). Applied on
# first feedback per evaluation, or when a resubmission changes the outcome.
# 0 disables.
RELIABILITY_LEARNING_RATE=0.05

# -----------------------------------------------------------------------------
# Usage Metering
# -----------------------------------------------------------------------------
# When true, /v1/evaluate rejects requests (429 QUOTA_EXCEEDED) once the tenant's
# monthly plan quota is exhausted. Default false: usage is reported via /v1/usage
# (and audit-logged) but never blocks the pipeline.
USAGE_ENFORCE_QUOTA=false

# -----------------------------------------------------------------------------
# Sentry Error Tracking (Optional - recommended for production)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your-key@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
